; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Nightfall Survivor"
config/description="PC prototype for a top-down roguelite."
run/main_scene="res://src/levels/main.tscn"
config/features=PackedStringArray("4.5")
boot_splash/bg_color=Color(0.105882, 0.121569, 0.223529, 1)
config/icon="res://src/shared/assets/poc/coin/coin.svg"

[autoload]

InputDriver="*res://src/shared/scripts/input_driver.gd"
GameConfig="*res://src/autoload/game_config.gd"
EventBus="*res://src/autoload/event_bus.gd"
GameCatalog="*res://src/autoload/game_catalog.gd"
ConfigValidator="*res://src/autoload/config_validator.gd"
SpawnService="*res://src/autoload/spawn_service.gd"
EnemyManager="*res://src/autoload/enemy_manager.gd"
LevelManager="*res://src/autoload/level_manager.gd"
DamageSystem="*res://src/autoload/damage_system.gd"
ProjectilePool="*res://src/autoload/projectile_pool.gd"
EffectPool="*res://src/autoload/effect_pool.gd"
WeaponRegistry="*res://src/autoload/weapon_registry.gd"
WeaponSystem="*res://src/autoload/weapon_system.gd"
EnemyPool="*res://src/autoload/enemy_pool.gd"
Logger="*res://src/autoload/logger.gd"
VersionInfo="*res://src/autoload/version_info.gd"
IntegrityChecker="*res://src/autoload/integrity_checker.gd"
SteamManager="*res://src/autoload/steam_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray()

[filesystem]

import/blender/enabled=false

